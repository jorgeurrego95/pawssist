{
  "expo": {
    "name": "Pawssist",
    "slug": "pawssist",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "pawssist",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2D6A4F"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "autolinkingModuleResolution": true
    }
  }
}
